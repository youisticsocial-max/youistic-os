# Youistic OS - Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase ───────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── App & Security ─────────────────────────
# SESSION_SECRET must be a strong random secret (minimum 32 characters). Generate with: openssl rand -base64 32
SESSION_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── WhatsApp Cloud API Webhook ─────────────
WHATSAPP_VERIFY_TOKEN="youistic_whatsapp_secret_token_2026"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

