# Youistic OS - Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase ───────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── App & Security ─────────────────────────
# SESSION_SECRET must be configured with a strong random value (minimum 32 characters long).
# To generate a strong secret locally on Linux/macOS/Git Bash, run: openssl rand -base64 32
# Copy and paste the generated string value into SESSION_SECRET in your environment.
SESSION_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# ─── WhatsApp Cloud API Webhook ─────────────
WHATSAPP_VERIFY_TOKEN="youistic_whatsapp_secret_token_2026"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

